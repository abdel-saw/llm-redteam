# --- LLM providers ---
# Cle API Groq (obligatoire pour le provider par defaut).
GROQ_API_KEY=

# Cle API OpenRouter (utilisee en fallback si Groq echoue).
OPENROUTER_API_KEY=

# Provider actif au demarrage : "groq" ou "openrouter".
LLM_PROVIDER=groq

# --- Modeles ---
# Modele utilise par l'agent attaquant.
ATTACKER_MODEL=llama-3.3-70b-versatile

# Modele utilise comme juge semantique (verdict sur la reponse de la cible).
JUDGE_MODEL=llama-3.3-70b-versatile

# Modele utilise comme juge de securite (classification de contenu).
# Defaut : GPT-OSS-Safeguard 20B (policy-based, remplace Llama Guard 4 deprecie
# par Groq le 10/02/2026).
GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Format du juge de securite :
#   "policy"   = bring-your-own-policy (GPT-OSS-Safeguard) [defaut]
#   "taxonomy" = MLCommons safe/unsafe Sx (Llama Guard 3 fallback)
GUARD_MODE=policy

# --- Persistance ---
# URL SQLAlchemy. Par defaut : SQLite local.
DATABASE_URL=sqlite:///./redteam.db

# --- Environnement ---
# "dev" active le rechargement / les logs verbeux. "prod" pour le deploiement.
APP_ENV=dev
