<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="LLM-RT {{ VERSION }}">
  <title>LLM-RT — Scan #{{ ctx.scan.id }} — {{ ctx.target_name }}</title>
  <style>
    {% include 'report/_styles.css.j2' %}
  </style>
</head>
<body>
  <main>
    {# ===================== Header ===================== #}
    <header class="report-header">
      <div class="brand-strip">
        <span class="logo">LLM-RT</span>
        <span class="title">Security Assessment Report</span>
        <span class="meta">
          Scan #{{ ctx.scan.id }} · {{ ctx.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}
        </span>
      </div>
      <p class="strategy" style="margin: 8px 4px 0; color: var(--c-muted);">
        Generated by LLM-RT v{{ VERSION }} — PFE Master RSI, FST Settat.
      </p>
    </header>

    {# ===================== Executive summary ===================== #}
    <h2>Executive Summary</h2>
    <div class="exec-grid">
      {# Cible + métadonnées #}
      <div class="card">
        <h3>Target</h3>
        <table class="meta-table">
          <tr><th>Name</th><td>{{ ctx.target_name }}</td></tr>
          <tr><th>Type</th><td><code>{{ ctx.target_type }}</code></td></tr>
          {% if ctx.target_model %}
            <tr><th>Model</th><td><code>{{ ctx.target_model }}</code></td></tr>
          {% endif %}
          <tr><th>Scan started</th>
            <td>{{ ctx.scan.started_at.strftime("%Y-%m-%d %H:%M UTC") if ctx.scan.started_at else "—" }}</td>
          </tr>
          <tr><th>Scan ended</th>
            <td>{{ ctx.scan.finished_at.strftime("%Y-%m-%d %H:%M UTC") if ctx.scan.finished_at else "—" }}</td>
          </tr>
          <tr><th>Duration</th>
            <td>{{ ('%.1f s' % ctx.duration_seconds) if ctx.duration_seconds is not none else "—" }}</td>
          </tr>
          <tr><th>Total attempts</th><td>{{ ctx.total_attempts }}</td></tr>
        </table>
      </div>

      {# Score + verdict + KPI #}
      <div class="card score-card">
        <h3>Robustness</h3>
        <div class="score-main">
          <div>
            <span class="score-value">
              {{ ('%.0f' % ctx.robustness_score) if ctx.robustness_score is not none else "—" }}
            </span>
            <span class="score-unit">/ 100</span>
          </div>
          <span class="score-verdict {{ ctx.verdict_css_class }}">{{ ctx.verdict_label }}</span>
        </div>
        {% if ctx.robustness_score is not none %}
          <div class="gauge">
            <div class="gauge-marker"
                 style="left: calc({{ ctx.robustness_score }}% - 2px);"></div>
          </div>
          <div class="gauge-scale">
            <span>0 (Critical)</span><span>40</span><span>60</span><span>80</span><span>100 (Robust)</span>
          </div>
        {% endif %}
        <div class="kpi-grid">
          <div class="kpi">
            <div class="value">{{ ctx.successful_attacks }}</div>
            <div class="label">Successful attacks</div>
          </div>
          <div class="kpi">
            <div class="value">{{ ctx.total_attempts }}</div>
            <div class="label">Total attempts</div>
          </div>
          <div class="kpi">
            <div class="value">{{ '%.1f' % (ctx.success_rate * 100) }}%</div>
            <div class="label">Success rate</div>
          </div>
        </div>
      </div>
    </div>

    {# Heat map #}
    {% if ctx.categories %}
      <h3>Category heat map</h3>
      <div class="heatmap">
        {% for cat in ctx.categories %}
          {% set pct = cat.success_rate * 100 %}
          {% if cat.total == 0 %}
            {% set tone = 'hm-x' %}
          {% elif pct >= 80 %}
            {% set tone = 'hm-4' %}
          {% elif pct >= 60 %}
            {% set tone = 'hm-3' %}
          {% elif pct >= 40 %}
            {% set tone = 'hm-2' %}
          {% elif pct >= 20 %}
            {% set tone = 'hm-1' %}
          {% else %}
            {% set tone = 'hm-0' %}
          {% endif %}
          <div class="tile {{ tone }}">
            <div class="code">{{ cat.code }}</div>
            <div class="label">{{ cat.label }}</div>
            <div class="ratio">{{ cat.success }} / {{ cat.total }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ===================== Par catégorie ===================== #}
    <h2>OWASP Category Breakdown</h2>
    {% if ctx.categories %}
      {% for cat in ctx.categories %}
        {% include 'report/_category_section.html.j2' %}
      {% endfor %}
    {% else %}
      <p><em>No attempts recorded — the scan completed with zero attempts.</em></p>
    {% endif %}

    {# ===================== Toutes les tentatives ===================== #}
    <h2>All attempts</h2>
    <details>
      <summary>Show full list ({{ ctx.attempts_all | length }} attempts)</summary>
      <div class="filters">
        <label>Category
          <select id="f-category">
            <option value="">All</option>
            {% for cat in ctx.categories %}
              <option value="{{ cat.category.value }}">{{ cat.label }}</option>
            {% endfor %}
          </select>
        </label>
        <label>Verdict
          <select id="f-verdict">
            <option value="">All</option>
            <option value="success">success</option>
            <option value="partial">partial</option>
            <option value="failure">failure</option>
            <option value="error">error</option>
          </select>
        </label>
        <label>Severity
          <select id="f-severity">
            <option value="">All</option>
            <option value="critical">critical</option>
            <option value="high">high</option>
            <option value="medium">medium</option>
            <option value="low">low</option>
          </select>
        </label>
        <label>Search
          <input id="f-search" type="search" placeholder="prompt / response / reasoning…">
        </label>
        <button id="f-reset" class="reset-btn" type="button">Reset</button>
        <span class="strategy" id="f-counter">{{ ctx.attempts_all | length }} / {{ ctx.attempts_all | length }}</span>
      </div>

      <table id="attempts-table" class="attempts-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Category</th>
            <th>Strategy</th>
            <th>Verdict</th>
            <th>Severity</th>
            <th>Latency</th>
            <th>Detail</th>
          </tr>
        </thead>
        <tbody>
          {% for a in ctx.attempts_all %}
            {% set v = (a.judgment.value if a.judgment else 'error') %}
            {% set s = (a.severity.value if a.severity else 'low') %}
            <tr data-attempt
                data-category="{{ a.category.value }}"
                data-verdict="{{ v }}"
                data-severity="{{ s }}">
              <td class="num">{{ a.id }}</td>
              <td>{{ a.category.value }}</td>
              <td class="strategy">{{ a.strategy_name }}</td>
              <td><span class="badge v-{{ v }}">{{ v }}</span></td>
              <td><span class="badge sev-{{ s }}">{{ s }}</span></td>
              <td class="num">{{ a.latency_ms if a.latency_ms is not none else '—' }} ms</td>
              <td><a href="#attempt-{{ a.id }}">view</a></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <h3 style="margin-top: 24px;">Attempt details</h3>
      {% for attempt in ctx.attempts_all %}
        {% include 'report/_attempt_detail.html.j2' %}
      {% endfor %}
    </details>

    {# ===================== Métadonnées du scan ===================== #}
    <h2>Scan metadata</h2>
    <table class="meta-table">
      <tr><th>Selected categories</th><td>{{ ctx.metadata.selected_categories }}</td></tr>
      <tr><th>Max attempts per category</th><td>{{ ctx.metadata.max_attempts_per_category }}</td></tr>
      <tr><th>Attacker model</th><td><code>{{ ATTACKER_MODEL }}</code></td></tr>
      <tr><th>Judge model</th><td><code>{{ JUDGE_MODEL }}</code></td></tr>
      <tr><th>Safety classifier</th><td><code>{{ GUARD_MODEL }}</code> ({{ GUARD_MODE }})</td></tr>
      <tr><th>LLM-RT version</th><td>v{{ VERSION }}</td></tr>
      {% if ctx.target_headers_preview %}
        <tr><th>Target headers (redacted)</th>
          <td>
            {% for name, value in ctx.target_headers_preview.items() %}
              <code>{{ name }}: {{ value }}</code><br>
            {% endfor %}
          </td>
        </tr>
      {% endif %}
    </table>

    {# ===================== Annexe ===================== #}
    <h2>Appendix</h2>
    <h3>Glossary</h3>
    <table class="meta-table">
      {% for term, definition in glossary %}
        <tr><th>{{ term }}</th><td>{{ definition }}</td></tr>
      {% endfor %}
    </table>

    <h3>Ethical use disclaimer</h3>
    <div class="disclaimer">
      This report is the output of automated adversarial testing
      ("red teaming") of a third-party LLM endpoint. Run it only against
      systems you own or have explicit written authorization to test.
      The attack templates included in LLM-RT cover OWASP LLM Top 10
      categories and are scoped to "borderline-but-evaluative" content
      (no genuinely dangerous instructions are emitted).
    </div>

    <h3>Methodology disclaimer</h3>
    <div class="disclaimer">
      Verdicts and severities are produced by an automated LLM-as-judge
      pipeline backed by a safety classifier. They are NOT ground truth
      and can contain false positives or false negatives. Review the raw
      attempts above before acting on any single verdict, especially
      those marked <code>partial</code> or <code>error</code>.
    </div>
  </main>

  <script>
    {% include 'report/_filter_script.js.j2' %}
  </script>
</body>
</html>
